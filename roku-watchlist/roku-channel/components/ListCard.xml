<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de uma lista na tela inicial: três pôsteres, nome e quantidade. -->
<component name="ListCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ListCard.brs" />
  <children>
    <Rectangle width="540" height="340" color="0x171920FF" />
    <Poster id="p1" translation="[20,20]" width="156" height="234" loadWidth="156" loadHeight="234" loadDisplayMode="scaleToZoom" />
    <Poster id="p2" translation="[192,20]" width="156" height="234" loadWidth="156" loadHeight="234" loadDisplayMode="scaleToZoom" />
    <Poster id="p3" translation="[364,20]" width="156" height="234" loadWidth="156" loadHeight="234" loadDisplayMode="scaleToZoom" />
    <Label id="name" translation="[20,264]" width="500" maxLines="1" color="0xECEEF3FF"
           font="font:SmallBoldSystemFont" />
    <Label id="count" translation="[20,302]" width="500" maxLines="1" color="0x9AA0ADFF"
           font="font:SmallestSystemFont" />
  </children>
</component>
