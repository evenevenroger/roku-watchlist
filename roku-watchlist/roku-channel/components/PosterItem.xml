<?xml version="1.0" encoding="utf-8"?>
<!-- Um pôster: capa, selos discretos (IMDb, minha nota), RT acima da faixa do prêmio, título e ano/serviços. -->
<component name="PosterItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PosterItem.brs" />
  <children>
    <Rectangle width="220" height="330" color="0x22252EFF" />
    <Poster id="poster" width="220" height="330" loadDisplayMode="scaleToZoom" />

    <Rectangle id="imdbBg" translation="[8,8]" width="44" height="24" color="0x0000006B" />
    <Label id="imdb" translation="[8,8]" width="44" height="24" horizAlign="center" vertAlign="center" color="0xF5C518FF">
      <Font role="font" uri="font:BoldSystemFontFile" size="17" />
    </Label>
    <Rectangle id="mineBg" translation="[156,8]" width="56" height="24" color="0x6C3FF58C" />
    <Label id="mine" translation="[156,8]" width="56" height="24" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
      <Font role="font" uri="font:BoldSystemFontFile" size="17" />
    </Label>

    <Group id="rt">
      <Rectangle id="rtBg" width="128" height="24" color="0x0000006B" />
      <Poster uri="pkg:/images/rt_tomato.png" translation="[5,4]" width="16" height="16" />
      <Label id="rtC" translation="[23,0]" width="40" height="24" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="16" />
      </Label>
      <Poster uri="pkg:/images/rt_popcorn.png" translation="[66,4]" width="16" height="16" />
      <Label id="rtA" translation="[84,0]" width="40" height="24" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="16" />
      </Label>
    </Group>

    <Group id="strip" translation="[0,298]">
      <Rectangle id="stripBg" width="220" height="32" />
      <Rectangle id="stripLine" width="220" height="2" color="0xE3C16FFF" />
      <Poster id="stripIcon" translation="[8,7]" width="18" height="18" />
      <Label id="stripText" translation="[32,0]" width="182" height="32" vertAlign="center">
        <Font role="font" uri="font:BoldSystemFontFile" size="15" />
      </Label>
    </Group>

    <Label id="title" translation="[0,340]" width="220" maxLines="1" color="0xECEEF3FF"
           font="font:SmallestBoldSystemFont" />
    <Label id="svc" translation="[0,372]" width="220" maxLines="1" color="0x9AA0ADFF"
           font="font:SmallestSystemFont" />
  </children>
</component>
